# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Required for the scenario's cloud agent tools: public origin of this same app.
# Cloud callbacks cannot access localhost. Do not claim live tools without testing reachability.
TOP_TEN_SCENARIO_TOOL_BASE_URL=

# Optional persistent local directory; defaults to .scenario-data.
# Ephemeral serverless hosting and multiple processes need a shared store.
TOP_TEN_DATA_DIR=
